{
  "name": "scholarships",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:android": "expo start --android --no-cache",
    "start:fast": "expo start --no-cache",
    "reset-project": "node ./scripts/reset-project.js",
