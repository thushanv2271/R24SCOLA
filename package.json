    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.1.1",
    "expo": "^53.0.0",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
